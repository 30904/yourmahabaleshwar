# Local Vite — leave empty to use same-origin /api proxy, or set absolute API URL
VITE_API_URL=http://localhost:5000/api

# CloudFront / CDN base URL for S3 uploads (no trailing slash)
# When set, media keys resolve through CDN instead of /uploads on the API host
VITE_CDN_URL=
# Alternative name for the same setting
VITE_CLOUDFRONT_URL=
