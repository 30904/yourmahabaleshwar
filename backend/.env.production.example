# Production — https://www.yourmahabaleshwar.com
# Copy to backend/.env on the server and fill secrets (never commit filled .env)

NODE_ENV=production
PORT=5000

# Atlas or private Mongo — REPLACE
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/yourmahabaleshwar?retryWrites=true&w=majority

# Browser origins allowed to call the API (exact match, no trailing slash)
CLIENT_URL=https://www.yourmahabaleshwar.com,https://yourmahabaleshwar.com

# Generate TWO different values:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRE=7d

# Razorpay LIVE
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL to register in Razorpay:
# https://www.yourmahabaleshwar.com/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=

FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=YMBSMS

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourmahabaleshwar.com

WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

FIREBASE_SERVICE_ACCOUNT_JSON=

MAX_FILE_SIZE=5242880
UPLOAD_PATH=./src/uploads

# Behind Cloudflare / nginx — keep 1 (omit or set 0 only for local without a proxy)
TRUST_PROXY=1
RATE_LIMIT_MAX=100

PUBLIC_API_URL=https://www.yourmahabaleshwar.com
