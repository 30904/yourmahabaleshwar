# Development defaults — copy to .env and adjust
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/yourmahabaleshwar

# Comma-separated frontend origins (no trailing slash)
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_REFRESH_EXPIRE=7d

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourmahabaleshwar.com

# Fast2SMS WhatsApp (Meta format). URL must include real Phone Number ID — no {braces}:
# https://www.fast2sms.com/dev/whatsapp/v26.0/YOUR_PHONE_NUMBER_ID/messages
WHATSAPP_API_URL=
# Fast2SMS API Authorization Key (same Dev API key is fine)
WHATSAPP_API_TOKEN=
# Approved AUTHENTICATION template name from WhatsApp Manager (e.g. ymb_otp_auth)
WHATSAPP_OTP_TEMPLATE=
# Must match template language (usually en_US)
WHATSAPP_OTP_LANGUAGE=en_US

# Optional: stringified Firebase service account JSON for FCM
FIREBASE_SERVICE_ACCOUNT_JSON=

MAX_FILE_SIZE=5242880
UPLOAD_PATH=./src/uploads

# --- Object storage (S3 + CloudFront) ---
# When AWS credentials and bucket are set, uploads go to S3 automatically.
# Otherwise files are stored locally under UPLOAD_PATH (served at /uploads).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=
# Optional root prefix inside the bucket (e.g. prod/your-mahabaleshwar)
S3_PREFIX=your-mahabaleshwar

# Public CDN URL — no trailing slash (e.g. https://d1234abcd.cloudfront.net)
CLOUDFRONT_DOMAIN=
# Alternative to CLOUDFRONT_DOMAIN
CDN_BASE_URL=

# Behind nginx/load balancer set TRUST_PROXY=1
TRUST_PROXY=0
RATE_LIMIT_MAX=200

# Optional public API base (for invoice links in emails)
PUBLIC_API_URL=http://localhost:5000

# Redis — required for multi-instance / production booking locks (prevents double-booking).
# Local single-process: omit REDIS_URL to use in-memory locks.
# Example: redis://127.0.0.1:6379
REDIS_URL=
