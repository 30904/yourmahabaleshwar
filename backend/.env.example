# Development defaults — copy to .env and adjust
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/yourmahabaleshwar

# Comma-separated frontend origins (no trailing slash)
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_REFRESH_EXPIRE=7d

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@yourmahabaleshwar.com

WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Optional: stringified Firebase service account JSON for FCM
FIREBASE_SERVICE_ACCOUNT_JSON=

MAX_FILE_SIZE=5242880
UPLOAD_PATH=./src/uploads

# Behind nginx/load balancer set TRUST_PROXY=1
TRUST_PROXY=0
RATE_LIMIT_MAX=200

# Optional public API base (for invoice links in emails)
PUBLIC_API_URL=http://localhost:5000
